# 复制为 .env 后按需修改。.env 已在 .gitignore 中，不会进仓库。

# ------------------------------------------------------------------ 上游
# 网关调用 xiaomusic 的地址。
#   Linux 宿主机：http://172.17.0.1:58090（docker0 网关地址）
#   Windows/Mac Docker Desktop：http://host.docker.internal:58090
UPSTREAM=http://172.17.0.1:58090

# 默认音箱 DID。留空则必须在请求里显式带 did，或在网页「高级设置」里填写。
DEFAULT_DID=

# 单条 TTS 文本最大长度
MAX_TEXT_LEN=500

# ------------------------------------------------------------------ 鉴权
# 0 = 关闭（默认，局域网内可直接调用）
# 1 = 开启，需在请求头带 Authorization: Bearer <TTS_TOKEN>
AUTH_ENABLED=0
TTS_TOKEN=change-me-please

# ------------------------------------------------------------------ 时区
TZ=Asia/Shanghai
NEWS_TZ=Asia/Shanghai

# 新闻服务数据目录（容器内路径，需挂载出来才能持久化）
NEWS_DIR=/data/news-service
# 前端静态目录
NEWS_STATIC=/gw/static
